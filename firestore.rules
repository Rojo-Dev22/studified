rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    // Helper: signed-in owner of the record (§14).
    function isOwner(userId) {
      return request.auth != null && request.auth.uid == userId;
    }

    // ── users/{uid} + subcollections — private per-user data ─────────────
    // Only the owner may read or write their own documents. The client can
    // create/update its own profile, stats and history; deleting the whole
    // account document stays server-managed. (Previously ANY signed-in user
    // could read ANY user's documents — a privacy hole.)
    match /users/{userId} {
      allow read: if isOwner(userId);
      allow create, update: if isOwner(userId);
      allow delete: if false;

      match /{subcollection}/{document=**} {
        allow read: if isOwner(userId);
        allow create, update: if isOwner(userId);
        allow delete: if isOwner(userId);
      }
    }

    // ── completionEvents/{eventId} — idempotency ledger (§13/§14) ───────
    // Create-once audit records: a reward event can be claimed a single time
    // and can never be rewritten afterwards (immutable audit fields).
    match /completionEvents/{eventId} {
      allow get, list: if request.auth != null
                       && resource.data.uid == request.auth.uid;
      allow create: if request.auth != null
                    && request.resource.data.uid == request.auth.uid
                    && request.resource.data.eventId == eventId;
      allow update, delete: if false;
    }

    // ── leaderboard/{uid} — one distributed record per user (§15) ───────
    // Every user writes ONLY their own entry (doc id must equal their uid)
    // and only with the expected field types; any signed-in user can read.
    // This replaces the old `allow write: if false`, which blocked cloud
    // leaderboard sync entirely (see BACKEND_AND_DATABASE.md known gotchas).
    match /leaderboard/{entryId} {
      allow read: if request.auth != null;
      allow create, update: if isOwner(entryId)
                            && request.resource.data.uid == entryId
                            && request.resource.data.total_xp is number
                            && request.resource.data.quests_completed is number
                            && request.resource.data.focus_hours is number
                            && request.resource.data.streak_days is number
                            && request.resource.data.level is number
                            && request.resource.data.full_name is string
                            && request.resource.data.avatar is string;
      allow delete: if false;
    }

    // ── guilds — shared social space (unchanged behavior) ────────────────
    match /guilds/{guildId} {
      allow read: if request.auth != null;
      allow create: if request.auth != null;
      allow update: if request.auth != null;
      allow delete: if request.auth != null;

      // Guild messages subcollection
      match /messages/{messageId} {
        allow read: if request.auth != null;
        allow create: if request.auth != null;
        allow update: if request.auth != null && request.auth.uid == resource.data.sender_uid;
        allow delete: if request.auth != null && request.auth.uid == resource.data.sender_uid;
      }
    }
  }
}